# ---------------------------------------------------------------- network
NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://free.rpc.fastnear.com
NEAR_EXPLORER=https://nearblocks.io

# ---------------------------------------------------------------- contract
MANDATE_CONTRACT=mandate-otc.near
MANDATE_ID=0

# The broker key. It can only *propose* trades; it cannot move vault funds.
AGENT_ACCOUNT=broker.near
AGENT_SECRET_KEY=
TREASURY_ACCOUNT=treasury.near

# The trader's key. Used once to sign the mandate and fund the vault.
# The demo dashboard never gets this key.
TRADER_ACCOUNT=amine.near
TRADER_SECRET_KEY=

# ---------------------------------------------------------------- settlement
# mock = real onchain policy checks, simulated settlement, no funds, no keys.
# live = real 1Click quote and a real ft_transfer from the contract vault.
SETTLEMENT_MODE=mock
MAX_TRADE_USDC=25

# Where the swapped BTC lands. Keep INTENTS to leave it on NEAR.
SETTLE_RECIPIENT=amine.near
SETTLE_RECIPIENT_TYPE=INTENTS

# Optional: raises the 1Click fee tier from 0.25% to 0.20%.
INTENTS_JWT=

# ---------------------------------------------------------------- private AI
# NEAR AI Cloud is OpenAI-compatible. Leave the key empty to run the
# deterministic broker with no model at all (the demo works either way).
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------- mandate defaults
MANDATE_SIZE_USDC=25
MANDATE_SLIPPAGE_BPS=40
MANDATE_FEE_BPS=5
MANDATE_MIN_REPUTATION=50
MANDATE_TTL_SECONDS=21600
